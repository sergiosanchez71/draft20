# Draft 20 — .htaccess raíz
# - URLs de assets versionadas con ?v=filemtime (ver index.php/juego.php) para
#   esquivar la caché del CDN de Hostinger en cada despliegue.
# - sw.js y manifest siempre revalidados para que el Service Worker se actualice.

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>
