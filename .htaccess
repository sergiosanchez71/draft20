# Draft 20 — .htaccess raíz
# - HTTPS obligatorio + canonical sin www (https://draft20.es).
# - URLs limpias para las páginas SEO (/tematica/<id>, /como-jugar, ...).
# - Compresión y caché: los assets van versionados con ?v=filemtime
#   (ver inc/layout.php) para esquivar la caché del CDN en cada despliegue.
# - sw.js y manifest siempre revalidados para que el Service Worker se actualice.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) www → https://draft20.es en un solo salto (cubre http y https).
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://draft20.es%{REQUEST_URI} [R=301,L]

    # 2) HTTP → HTTPS en un solo salto (ya sin www).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://draft20.es%{REQUEST_URI} [R=301,L]

    # 3) URLs limpias.
    RewriteRule ^tematica/([a-z0-9_]+)/?$ tematica.php?id=$1 [L,QSA]
    RewriteRule ^categoria/([a-z0-9_]+)/?$ categoria.php?id=$1 [L,QSA]
    RewriteRule ^guias/?$ guias.php [L]
    RewriteRule ^guia/([a-z0-9-]+)/?$ guia.php?slug=$1 [L,QSA]

    # 4) Catálogo interno: los valores de los ítems no se sirven por HTTP
    #    (el cliente los recibe por API solo cuando el modo lo permite).
    RewriteRule ^tematicas/ - [F,L]

    # 5) Superficie de desarrollo y archivos internos: nunca por HTTP.
    #    (El deploy sube todo el repo; esto evita exponer código y notas.)
    RewriteRule ^(tools|tests|docs|node_modules|vendor)(/|$) - [F,L]
    RewriteRule ^(README\.md|package(-lock)?\.json|composer\.(json|lock)|draft20\.iml|phpunit\.xml|AGENTS\.md)$ - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^como-jugar/?$ como_jugar.php [L]
    RewriteRule ^acerca/?$ acerca.php [L]
    RewriteRule ^contacto/?$ contacto.php [L]
    RewriteRule ^privacidad/?$ privacidad.php [L]
    RewriteRule ^aviso-legal/?$ aviso_legal.php [L]
    RewriteRule ^glosario/?$ glosario.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^feed\.xml$ feed.php [L]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
    # Assets versionados: caché larga (se invalidan con ?v=filemtime).
    <FilesMatch "\.(css|js|png|ico|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # sw.js y manifest siempre revalidados (van sin versión en el registro).
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>

    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # Cabeceras de seguridad. La CSP completa (con nonce para los scripts inline)
    # la emite PHP en las páginas HTML; aquí solo se fija frame-ancestors para
    # cubrir también las rutas que no pasan por layout (API, estáticos).
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
    Header always set Content-Security-Policy "frame-ancestors 'none'"
</IfModule>

# La landing y las páginas de contenido pueden cachearse 10 min en el CDN
# (el navegador siempre revalida). Las URLs con query (?sala=, ?tematica=)
# quedan fuera a propósito.
<IfModule mod_setenvif.c>
    <IfModule mod_headers.c>
        SetEnvIf Request_URI "^/$" es_landing
        SetEnvIf Request_URI "^/index\.php$" es_landing
        Header set Cache-Control "public, max-age=0, s-maxage=600" env=es_landing

        SetEnvIf Request_URI "^/(tematica|guia|guias|categoria|como-jugar|acerca|contacto|privacidad|aviso-legal|glosario)/?([a-z0-9_-]+)?/?$" es_contenido
        SetEnvIf Request_URI "^/feed\.xml$" es_contenido
        Header set Cache-Control "public, max-age=0, s-maxage=600" env=es_contenido
    </IfModule>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
